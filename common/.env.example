# 复制为 common/.env 后填写。common/.env 不要提交到任何仓库，也不要外发。

# ── 机器人凭据 ─────────────────────────────────
# 命名约定：BOT_<键名大写>_APPID / _SECRET / _GROUP_OPENID
# <键名> 就是 config.yaml 的 bots 段里那个名字。
# 加机器人时，复制一组改名填上即可；config.yaml 不写 *_env 时按这个约定读取。
#
# 群 group_openid（不是群号）每个机器人一个，即使同群也不共用。
# 获取：python common/scripts/capture_group_openid.py --bot <键名>，然后去群里 @ 它

BOT_MENU_APPID=
BOT_MENU_SECRET=
BOT_MENU_GROUP_OPENID=

BOT_NOTICE_APPID=
BOT_NOTICE_SECRET=
BOT_NOTICE_GROUP_OPENID=

# 操前小读机器人（群里 @ 它 → 生成 docx 并回传）
BOT_READER_APPID=
BOT_READER_SECRET=
BOT_READER_GROUP_OPENID=

# 新增机器人示例（config.yaml 里也加一段，键名 help）
# BOT_HELP_APPID=
# BOT_HELP_SECRET=
# BOT_HELP_GROUP_OPENID=

# ── 腾讯文档（MCP）─────────────────────────────
# 文档 URL 里 /smartsheet/ 后面那串**不是** file_id，真实值用 MCP 查。
TENCENT_DOC_FILE_ID=NhuIfHdfFsNp
TENCENT_DOC_SHEET_ID=t00i2h
TENCENT_DOC_SHEET_NAME=智能表1
# 个人 Token：https://docs.qq.com/open/auth/mcp.html
TENCENT_MCP_TOKEN=

# ── 可选：外部视觉模型 ──────────────────────────
# 只有当 WorkBuddy 用的模型不支持读图时才需要。
# 模型支持读图的话，整块留空即可。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_VISION_MODEL=
